# local-only manifests holding private values (real client IPs, etc.)
*.local.yaml
node_modules/
.DS_Store
Thumbs.db
*.log
.env
.env.*
!.env.example
coverage/
.build-*/
# public/ is committed for git-sync. Primary-source files are excluded.
**/원문/
**/검증자료/
**/검증/
**/1차자료/
*.pdf
*.pem
*.key
*-secret.yaml
# B/C/D include every Markdown file outside archive/private, even nested guides.
!B/**/
!C/**/
!D/**/
!B/**/*.md
!C/**/*.md
!D/**/*.md
B/**/archive/
B/**/private/
C/**/archive/
C/**/private/
D/**/archive/
D/**/private/
